# ---------------------------------------------------------------------------
# IGNYTfit — environment variables
#
# Copy to `.env.local` for local development, and set the same keys in the
# Vercel project settings for preview and production.
#
# Every variable here is optional: the site builds and deploys with none of
# them set. They exist to point the build at the right origin and, optionally,
# at a real inbox for the contact form.
# ---------------------------------------------------------------------------

# Canonical origin, no trailing slash.
#
# Used for canonical <link> tags, Open Graph URLs, JSON-LD, robots.txt and
# sitemap.xml. Set this to your production domain before the first deploy —
# without it the build falls back to https://ignytfit.in.
#
# On Vercel preview deployments, VERCEL_URL is used automatically instead, so
# previews never advertise themselves as the canonical site.
NEXT_PUBLIC_SITE_URL=https://ignytfit.in

# Optional. Endpoint the contact form POSTs JSON to
# ({ name, email, subject, message }).
#
# Works with Formspree, Formspark, a Vercel serverless function, or anything
# that accepts a JSON body. Leave unset and the form composes a pre-filled
# email in the visitor's mail client instead.
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Optional. Disables Next.js anonymous build telemetry.
NEXT_TELEMETRY_DISABLED=1
