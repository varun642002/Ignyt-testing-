<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext HTTP for LOCAL DEVELOPMENT BACKENDS ONLY.

    Android 9 (API 28) blocks plain HTTP by default, so a debug build talking to a backend on
    the developer's machine fails at the transport layer with nothing useful in the WebView —
    it looks exactly like "the server is down". That is the blocker this file removes.

    Scoped deliberately, NOT `android:usesCleartextTraffic="true"`:
      10.0.2.2    the Android emulator's alias for the host machine's loopback
      localhost   / 127.0.0.1 for a device forwarding a port over adb
      192.168.*   a physical device on the same LAN as the dev machine
                  (declared as the common private ranges, since a wildcard is not supported)

    Everything else on the internet still requires HTTPS, including the production backend.
    If this app is ever pointed at a real server over plain HTTP, that is a mistake this file
    will not rescue and should not.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Common LAN ranges for testing on a real handset. Add your own subnet here if it
             differs; there is no wildcard syntax for this. -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
    </domain-config>
</network-security-config>
