<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ exposes the launcher's own corner radius. Using it is what makes the widget
     match every other widget on the user's home screen instead of being 2dp off. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_bg"/>
    <corners android:radius="@android:dimen/system_app_widget_background_radius"/>
    <stroke android:width="1dp" android:color="@color/widget_stroke"/>
</shape>
