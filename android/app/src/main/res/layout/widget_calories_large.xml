<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp"
    android:theme="@style/IgnytWidgetTheme">

    <TextView
        android:id="@+id/w_value"
        android:text="1,842"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text"
        android:textSize="32sp"
        android:fontFamily="sans-serif-black"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"/>

    <TextView
        android:id="@+id/w_label"
        android:text="of 2,400 kcal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/widget_muted"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"/>

    <TextView
        android:id="@+id/w_sub"
        android:text="558 left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/widget_muted"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"/>

    <ProgressBar
        android:id="@+id/w_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="77"
        android:progressDrawable="@drawable/widget_progress"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:weightSum="3">
        <TextView android:id="@+id/w_p"
            android:text="P 142g"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginEnd="8dp" android:textColor="@color/widget_accent"
            android:textSize="13sp" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/w_c"
            android:text="C 186g"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginEnd="8dp" android:textColor="@color/widget_amber"
            android:textSize="13sp" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/w_f"
            android:text="F 54g"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/widget_purple"
            android:textSize="13sp" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>
