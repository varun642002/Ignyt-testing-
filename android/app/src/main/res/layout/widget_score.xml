<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    android:theme="@style/IgnytWidgetTheme">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/w_ring"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/widget_progress_desc"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
    <TextView
        android:id="@+id/w_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text"
        android:textSize="26sp"
        android:fontFamily="sans-serif-black"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"/>
    <TextView
        android:id="@+id/w_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_muted"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"
        />
    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_muted"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"
        />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_tasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_muted"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:weightSum="3">
        <TextView android:id="@+id/w_qa_workout" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:background="@drawable/widget_chip"
            android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp"
            android:layout_marginEnd="6dp" android:text="@string/widget_qa_workout"
            android:textColor="@color/widget_text" android:textSize="11sp"/>
        <TextView android:id="@+id/w_qa_food" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:background="@drawable/widget_chip"
            android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp"
            android:layout_marginEnd="6dp" android:text="@string/widget_qa_food"
            android:textColor="@color/widget_text" android:textSize="11sp"/>
        <TextView android:id="@+id/w_qa_water" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:background="@drawable/widget_chip"
            android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp"
            android:text="@string/widget_qa_water"
            android:textColor="@color/widget_text" android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>
