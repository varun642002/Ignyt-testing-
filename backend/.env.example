# IGNYT Integration Service — environment (Phase 2)
# Copy to `.env` for local dev. In production, set these in your host's secret manager.
# NEVER commit a real .env.

# --- App ---
APP_NAME=IGNYT Integration Service
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=info
API_PREFIX=/v1

# --- Database ---
# Local dev (zero infra): SQLite file.
DATABASE_URL=sqlite+aiosqlite:///./ignyt_integration.db
# Production example (Postgres):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/ignyt
DB_ECHO=false

# --- CORS: exact IGNYT origins allowed to call the API ---
# capacitor://localhost and https://localhost cover the Android app itself.
# The localhost:41xx entries are for testing the web build in a browser — a
# missing origin here fails as a rejected fetch, which is indistinguishable
# from being offline, so it is worth getting right.
CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost,http://localhost:4173,http://localhost:4188,http://127.0.0.1:4188

# --- Identity (Firebase Admin) ---
AUTH_MODE=firebase                # firebase (prod) | insecure-uid (LOCAL DEV ONLY)
# Path to the service-account JSON, OR the JSON content inline. Download from
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
FIREBASE_CREDENTIALS=./firebase-service-account.json
FIREBASE_PROJECT_ID=

# --- Crypto / OAuth (declared now; required from Phase 3) ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
STATE_SIGNING_SECRET=

# --- Local-dev shortcut ---
# For running the API without Firebase locally, set AUTH_MODE=insecure-uid and send
# an "X-Ignyt-Uid: <uid>" header. Refused when ENVIRONMENT=production.

# --- AI food recognition (Gemini Vision) ---
# Required for AI scanning. Without it the service still runs and every other route
# works; /v1/food/scan-status simply reports ai_configured=false and the app hides the
# scan button instead of offering something that cannot work.
# This key is used ONLY by the backend. It is never returned by a route and never logged.
GEMINI_API_KEY=
# An alias, not a pinned version: gemini-2.0-flash was retired and broke every
# scan. Pin a version here only if you want to own the upgrades yourself.
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=20
AI_SCAN_DAILY_LIMIT=15
MAX_UPLOAD_BYTES=6291456
